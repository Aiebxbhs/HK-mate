# Configuration is read from environment variables; see README for exporting them.
HKM_DATABASE_PATH=private-data/hkumate.sqlite3
HKM_COOKIE_SECURE=false
HKM_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000
# OAuth values point to local files, never paste client secrets into this example.
HKM_GOOGLE_CLIENT_FILE=private-data/google-oauth-client.json
HKM_GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/email-connections/google/callback
HKM_TOKEN_KEY_FILE=private-data/mail-token.key
HKM_WEB_URL=http://127.0.0.1:5173
HKM_AUTO_MAIL_ENABLED=true
# Home-page AI assistant and Google services. Put real keys in private-data/agent.env
# (Git-ignored, read by scripts/dev.sh and serve.sh; only HKM_AGENT_* lines are read) or in
# your shell environment, never in this file or Git.
# 1. Active model. Providers: openai, gemini, qwen_intl, qwen, deepseek, moonshot, zhipu, custom
HKM_AGENT_PROVIDER=openai
HKM_AGENT_MODEL=
# 2. One key per provider (HKM_AGENT_<PROVIDER>_API_KEY); only the active provider's is used.
HKM_AGENT_OPENAI_API_KEY=
HKM_AGENT_DEEPSEEK_API_KEY=
# 3. Google Maps Platform key (Places API (New) and later Maps APIs; not Gmail OAuth)
HKM_AGENT_GOOGLE_MAPS_API_KEY=
# 4. Advanced (empty = default)
HKM_AGENT_BASE_URL=
HKM_AGENT_REASONING_EFFORT=low
HKM_AGENT_MAX_OUTPUT_TOKENS=4000
HKM_AGENT_TIMEOUT_SECONDS=60
# Optional override for every provider
HKM_AGENT_API_KEY=
